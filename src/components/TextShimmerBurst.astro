---
const { text } = Astro.props;
const BURST_COUNT = 3;
const GAP_RATIO = 1.5;
const burstStarts = Array.from({ length: BURST_COUNT }, function (_, index) {
  return (1 - GAP_RATIO ** -index) / (1 - 1 / GAP_RATIO);
});
---

<span class="shimmer-text grid-stack font-medium">
  <span class="rainbow-text">{text}</span>
  {
    burstStarts.map(function (start) {
      return (
        <span
          class="shimmer-beam animate-shimmer-burst"
          style={`animation-delay: ${start}s;`}
          aria-hidden="true"
        >
          {text}
        </span>
      );
    })
  }
</span>

<style>
  .shimmer-text {
    display: inline-grid;
  }

  .rainbow-text,
  .shimmer-beam {
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .rainbow-text {
    background-image: linear-gradient(
      to right,
      var(--color-amber-500),
      var(--color-green-500) 20%,
      var(--color-sky-500) 40%,
      var(--color-violet-500) 60%,
      var(--color-pink-500) 80%,
      var(--color-orange-500)
    );
    background-size: 150% 100%;
    animation: rainbow-drift 30s ease-in-out infinite alternate;
  }

  .shimmer-beam {
    mix-blend-mode: screen;
    background-image: linear-gradient(
      110deg,
      transparent 44%,
      color-mix(in srgb, var(--color-white) 65%, transparent) 48%,
      var(--color-white) 50%,
      color-mix(in srgb, var(--color-white) 65%, transparent) 52%,
      transparent 56%
    );
    background-size: 300% 100%;
    background-position: 200% 0;
    background-repeat: no-repeat;
  }

  @keyframes rainbow-drift {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rainbow-text {
      animation: none;
    }

    .shimmer-beam {
      animation: none;
      visibility: hidden;
    }
  }
</style>
