---
import Layout from "@/components/Layout.astro";
import Divider from "@/components/Divider.astro";
import Prose from "@/components/Prose.astro";
import Footer from "@/components/Footer.astro";

import DefaultHeader from "@/components/post/Header.astro";
import AgentHeader from "@/components/post/headers/AgentHeader.astro";
import CommandKHeader from "@/components/post/headers/CommandKHeader.astro";
import CommentsHeader from "@/components/post/headers/CommentsHeader.astro";
import MarkdownHeader from "@/components/post/headers/MarkdownHeader.astro";

import type { Post } from "@/content.config";
import type { PostFrontmatter } from "@/content.config";
import type { PostLayouts } from "@/lib/types";

import { cn } from "@/lib/utils";

export type PostWithImages = Post & {
  optimizedImageSrc?: string;
  ogImageSrc?: string;
  optimizedImageDarkSrc?: string;
};

const headerComponents: Record<(typeof PostLayouts)[number], typeof AgentHeader> = {
  agent: AgentHeader,
  "command-k": CommandKHeader,
  comments: CommentsHeader,
  markdown: MarkdownHeader,
};

type FrontmatterProps = {
  frontmatter?: PostFrontmatter & { og?: string };
  className?: string;
};

type PostProps = {
  post?: PostWithImages;
  className?: string;
  layout?: (typeof PostLayouts)[number];
};

interface Props extends FrontmatterProps, PostProps {}

const { post, frontmatter, className, layout } = Astro.props as Props;
const data = (post?.data ?? frontmatter)!;
const ogImageSrc = post?.ogImageSrc ?? frontmatter?.og;

const HeaderComponent = layout ? headerComponents[layout] : undefined;
---

<Layout
  title={`${data.title} - @heymynameisrob`}
  description={data.description}
  og={ogImageSrc}
  canonical={data.canonical}
>
  <div
    class={cn(
      "max-h-screen overflow-y-scroll animate-in fade-in-0 blur-in-md duration-400 ease-out",
      className
    )}
  >
    <div
      class="fixed top-0 inset-x-0 pointer-events-none bg-linear-to-b from-background to-transparent h-10 z-10"
    >
    </div>
    <div
      class="mx-auto flex max-w-3xl flex-1 flex-col gap-6 px-4 py-12 md:px-6 lg:gap-12 lg:px-8 2xl:py-20"
    >
      <slot name="before" />
      {HeaderComponent ? <HeaderComponent title={data.title} /> : <DefaultHeader data={data} />}
      <Prose>
        <slot />
      </Prose>
      <Footer />
    </div>
  </div>
  <slot name="after" />
</Layout>
