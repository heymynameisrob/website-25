---
import { SunIcon, MoonIcon } from "@heroicons/react/16/solid";
---

<button
  id="themeToggle"
  role="switch"
  aria-checked="false"
  aria-label="Toggle theme"
  class="flex items-center justify-center size-6 text-gray-9 bg-transparent transition-all focus hover:bg-gray-4 rounded-lg"
>
  <SunIcon className="hidden w-4 h-4 opacity-70 dark:block" />
  <MoonIcon className="visible w-4 h-4 opacity-70 dark:hidden" />
</button>
<script is:inline>
  const updateAriaChecked = () => {
    const toggle = document.getElementById("themeToggle");
    if (toggle) {
      toggle.setAttribute(
        "aria-checked",
        document.documentElement.classList.contains("dark") ? "true" : "false"
      );
    }
  };

  const setTheme = (() => {
    const localStorageTheme = localStorage?.getItem("theme") ?? "";
    console.log("Setting themes...");
    if (["dark", "light"].includes(localStorageTheme)) {
      if (localStorageTheme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      updateAriaChecked();
      return localStorage.setItem("theme", localStorageTheme);
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      document.documentElement.classList.add("dark");
      updateAriaChecked();
      return localStorage.setItem("theme", "dark");
    }
    document.documentElement.classList.remove("dark");
    updateAriaChecked();
    return localStorage.setItem("theme", "light");
  })();

  const handleToggleClick = () => {
    const element = document.documentElement;
    const isDark = element.classList.contains("dark");

    // Toggle theme
    element.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "light" : "dark");

    updateAriaChecked();

    requestAnimationFrame(() => {
      document.documentElement.style = "";
      document.body.style = "";
    });
  };

  document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
</script>
