---
import { AnimateInUp } from "./Motion";
import LinkWithIcon from "./LinkWithIcon.astro";
---
<AnimateInUp
  as="section"
  className="flex flex-col gap-8 max-w-prose"
  delay={0.2}
  client:load
>
  <p class="text-base text-secondary">
    I'm a design engineer working at
    <LinkWithIcon href="https://n8n.io" icon="n8n" label="n8n" />,
    an open-source project building the future of AI automation.
    I love designing performant, accessible interfaces that are deeply rooted in craft and quality.
  </p>
  <AnimateInUp delay={0.25} as="p" className="text-base text-secondary" client:load>
    Contact me on{" "}
    <LinkWithIcon href="https://linkedin.com/in/heymynameisrob" icon="linkedin" label="LinkedIn" />
    or via{" "}
    <LinkWithIcon href="mailto:robhough180@gmail.com" icon="email" label="email" />{" "}
    . See my code on{" "}
    <LinkWithIcon href="https://github.com/heymynameisrob" icon="github" label="GitHub" />
    .
  </AnimateInUp>
</AnimateInUp>
