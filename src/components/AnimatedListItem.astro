---
import { AnimateInUp } from "@/components/Motion.tsx";
import { ArrowUpRightIcon } from "@heroicons/react/16/solid";
import { Badge } from "@/components/Badge";

interface Props {
  href: string;
  label: string;
  description?: string;
  delay?: number;
  external?: boolean;
  featured?: boolean;
}

const { href, label, description, delay = 0.4, external = false } = Astro.props;
---

<AnimateInUp delay={delay} client:load>
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "nofollow noopener" : undefined}
    class="group flex items-center gap-1.5 -mx-4 bg-transparent px-4 min-h-11 py-1.5 rounded-lg focus"
  >
    <div class="min-w-0 w-full inline-flex items-baseline gap-1.5 text-lg lg:text-xl">
      <h3
        class="shrink-0 text-primary font-medium group-hover:underline decoration-2 decoration-primary underline-offset-2"
      >
        {label}
      </h3>
      <p class="min-w-0 truncate text-secondary leading-normal">{description}</p>
    </div>
  </a>
</AnimateInUp>
