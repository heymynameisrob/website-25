---
import { AnimateInUp } from "@/components/Motion.tsx";
import { ArrowUpRightIcon } from "@heroicons/react/16/solid";
import { Badge } from "@/components/Badge";

interface Props {
  href: string;
  label: string;
  description: string;
  delay?: number;
  external?: boolean;
  featured?: boolean;
}

const { href, label, description, delay = 0.4, external = false } = Astro.props;
---

<AnimateInUp delay={delay} client:load>
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "nofollow noopener" : undefined}
    class="group flex items-center gap-1.5 -mx-3 bg-transparent px-3 h-10 rounded-lg hover:bg-gray-3 focus focus-visible:bg-gray-3"
  >
    <div class="inline-flex items-baseline gap-1.5">
      <h3 class="text-base text-primary font-medium">
        {label}
      </h3>
      <p class="text-base text-secondary leading-normal text-balance font-serif truncate">
        {description}
      </p>
    </div>
    {
      external && (
        <ArrowUpRightIcon className="opacity-0 group-hover:opacity-100 size-4 -ml-0.5 inline duration-100 text-gray-9" />
      )
    }
  </a>
</AnimateInUp>
