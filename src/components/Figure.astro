---
import { cn } from "@/lib/utils";

interface Props {
  className?:string;
  caption?:string;
}

const {className, caption} = Astro.props;
---

<figure class="not-prose my-12 flex flex-col gap-4">
  <div class={cn("group/codeblock border relative rounded-lg overflow-hidden bg-gray-1 aspect-video grid place-items-center", className)}>
    <slot />
  </div>
  {caption && <figcaption class="text-xs text-gray-10 text-center px-5 mx-auto my-0">{caption}</figcaption>}
</figure>
