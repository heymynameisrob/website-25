---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import AnimatedListItem from "@/components/AnimatedListItem.astro";
import HomeHeader from "@/components/HomeHeader.astro";

import { AnimateInUp } from "@/components/Motion";
import { HomeWorkGrid } from "@/components/demos/HomeWorkGrid";
import { BallpointWithHoverCard } from "@/components/BallpointWithHoverCard";
---
<Layout>
  <div
    class="w-full max-w-prose mx-auto flex flex-col gap-8 my-16 lg:my-24 lg:gap-12 px-5"
  >
   <BallpointWithHoverCard client:load />
   <HomeHeader />
   <AnimateInUp
     as="section"
     className="flex flex-col gap-4"
     delay={0.3}
     client:load
   >
   <h3 class="text-sm font-medium text-gray-10 tracking-tight">Work</h3>
   <HomeWorkGrid client:load />
   </AnimateInUp>
    <AnimateInUp
      as="section"
      className="flex flex-col gap-4"
      delay={0.4}
      client:load
    >
    <h3 class="text-sm font-medium text-gray-10 tracking-tight">Projects</h3>
    <ul class="flex flex-col gap-px">
      <AnimatedListItem
        href="#"
        label="Travel"
        description="Gallery of my travel photos over the years"
        delay={0.4}
        external
      />
      <AnimatedListItem
        href="https://cushion.so"
        label="Cushion"
        description="Modern collaboration platform for remote teams"
        delay={0.45}
        external
      />
      <AnimatedListItem
        href="https://github.com/heymynameisrob/milos-zed-theme"
        label="Milos"
        description="Tangerine and duck-egg flavoured Zed theme"
        delay={0.5}
        external
      />
      <AnimatedListItem
        href="https://github.com/heymynameisrob/agent-config"
        label="Agent config"
        description="My setup for agentic coding"
        delay={0.55}
        external
      />
    </ul>
    </AnimateInUp>
    <AnimateInUp
      as="section"
      className="flex flex-col gap-4"
      delay={0.6}
      client:load
    >
      <footer class="w-full flex items-center gap-2">
        <small class="text-xs text-gray-9">&copy; 2026 heymynameisrob • </small>
        <a href="https://github.com/heymynameisrob/website-25" rel="noopener noreferrer" target="_blank" class="text-xs text-gray-9 underline hover:text-primary">View code</a>
        <ThemeToggle />
      </footer>
    </AnimateInUp>

  </div>
</Layout>
