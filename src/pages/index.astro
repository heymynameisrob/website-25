---
import Layout from "@/components/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import AnimatedListItem from "@/components/AnimatedListItem.astro";
import HomeHeader from "@/components/HomeHeader.astro";
import Footer from "@/components/Footer.astro";

import { AnimateInUp } from "@/components/Motion";
import { HomeWorkGrid } from "@/components/home-work-grid";
import { ConditionalHeader } from "@/components/ConditionalHeader";

const projects = [
  {
    href: "https://github.com/heymynameisrob/reader-mode",
    label: "EasyReader",
    description: "Strip slop from websites so you can actually read them",
  },
  {
    href: "#",
    label: "Travel",
    description: "Gallery of my travel photos over the years",
  },
  {
    href: "https://cushion.so",
    label: "Cushion",
    description: "Modern collaboration platform for remote teams",
  },
  {
    href: "https://github.com/heymynameisrob/milos-zed-theme",
    label: "Milos",
    description: "Tangerine and duck-egg flavoured Zed theme",
  },
  {
    href: "https://github.com/heymynameisrob/pi-config",
    label: "Pi",
    description: "My setup for agentic coding with pi.dev",
  },
];
---

<Layout>
  <div class="w-full max-w-prose mx-auto flex flex-col my-16 gap-16 px-5 pt-8">
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.1} client:load>
      <ConditionalHeader client:load />
    </AnimateInUp>
    <HomeHeader />
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.3} client:load>
      <HomeWorkGrid client:load />
    </AnimateInUp>
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.4} client:load>
      <h3 class="text-sm font-medium text-gray-10 tracking-tight">Projects</h3>
      <ul class="flex flex-col gap-px">
        {
          projects.map((project, i) => (
            <AnimatedListItem {...project} delay={0.4 + i * 0.05} external />
          ))
        }
      </ul>
    </AnimateInUp>
    <Footer />
  </div>
</Layout>
