---
import Layout from "@/components/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import AnimatedListItem from "@/components/AnimatedListItem.astro";
import HomeHeader from "@/components/HomeHeader.astro";
import Footer from "@/components/Footer.astro";

import { AnimateInUp } from "@/components/Motion";
import { HomeWorkGrid } from "@/components/home-work-grid";
import { ConditionalHeader } from "@/components/ConditionalHeader";

import links from "@/lib/more";
---

<Layout>
  <div class="w-full max-w-prose mx-auto flex flex-col my-16 gap-16 px-5 pt-8">
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.1} client:load>
      <ConditionalHeader client:only="react" />
    </AnimateInUp>
    <HomeHeader />
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.3} client:load>
      <HomeWorkGrid client:load />
    </AnimateInUp>
    <AnimateInUp as="section" className="flex flex-col gap-4" delay={0.4} client:load>
      <h3 class="text-sm font-medium text-gray-10 tracking-tight">More</h3>
      <ul class="flex flex-col gap-px">
        {links.map((link, i) => <AnimatedListItem {...link} delay={0.4 + i * 0.05} />)}
      </ul>
    </AnimateInUp>
    <Footer />
  </div>
</Layout>
